{
  "extends": "../../tsconfig.angular.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "types": [],
    "ignoreDeprecations": "6.0"
  },
  "files": ["src/main.ts"],
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts"
  ],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
